    <ProjectReference Include="..\..\paskalON.Common\paskalON.Telemetry\paskalON.Telemetry.csproj" />
    <ProjectReference Include="..\paskalON.Alarms.Application\paskalON.Alarms.Application.csproj" />
    <ProjectReference Include="..\paskalON.Alarms.Infrastructure\paskalON.Alarms.Infrastructure.csproj" />
    <ProjectReference Include="..\paskalON.Alarms.Service.Dto\paskalON.Alarms.Service.Dto.csproj" />
  </ItemGroup>

</Project>
