#------------------------------------------------------------------------------
# Variables
#------------------------------------------------------------------------------
@paskalON.OperatingModes.Service_HostAddress = http://localhost:45020

#------------------------------------------------------------------------------
# Stack controller
#------------------------------------------------------------------------------
POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/stack/addoperatingmode
Content-Type: application/json

{
    "operatingModeName": "ActivePowerFixedMode",
    "priority": 1
}

###

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/stack/moveoperatingmode
Content-Type: application/json

{
    "operatingModeName": "ActivePowerFixedMode",
    "priority": 2
}

###

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/stack/removeoperatingmode
Content-Type: application/json

{
    "operatingModeName": "ActivePowerFixedMode"
}

###


#------------------------------------------------------------------------------
# System controller
#------------------------------------------------------------------------------
POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/system/startallpcs

###

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/system/stopallpcs

###

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/system/standbyallpcs

###

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/system/setsetpoint
Content-Type: application/json

{
    "activePowerWatts": 3000000,
    "reactivePowerVars": 1000000
}

###


#------------------------------------------------------------------------------
# Version controller
#------------------------------------------------------------------------------
GET {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/version/
Accept: application/json

###