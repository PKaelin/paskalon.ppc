#------------------------------------------------------------------------------
# Variables
#------------------------------------------------------------------------------
@paskalON.OperatingModes.Service_HostAddress = http://localhost:45020

#------------------------------------------------------------------------------
# Stack controller
# Modes: ActivePowerFixedMode, ReactivePowerFixedMode, ActivePowerMode,
#        ReactivePowerMode
#------------------------------------------------------------------------------
@stack.operatingModeName = ActivePowerFixedMode

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/stack/addoperatingmode
Content-Type: application/json

{
    "operatingModeName": "{{stack.operatingModeName}}",
    "priority": 1
}

###

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/stack/moveoperatingmode
Content-Type: application/json

{
    "operatingModeName": "{{stack.operatingModeName}}",
    "priority": 2
}

###

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/stack/removeoperatingmode
Content-Type: application/json

{
    "operatingModeName": "{{stack.operatingModeName}}"
}

###


GET {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/stack/getavailableoperatingmodes
Accept: application/json

###

GET {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/stack/getactiveoperatingmodes
Accept: application/json

###



#------------------------------------------------------------------------------
# Override controller
# Modes: ShutdownMode, MaintenanceMode-BMS-Unit1
#------------------------------------------------------------------------------
@stack.overrideOperatingModeName = ShutdownMode

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/override/activateoperatingmode
Content-Type: application/json
{
    "operatingModeName": "{{stack.overrideOperatingModeName}}"
}

###

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/override/deactivateoperatingmode
Content-Type: application/json
{
    "operatingModeName": "{{stack.overrideOperatingModeName}}"
}

###

#------------------------------------------------------------------------------
# System controller
#------------------------------------------------------------------------------
POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/system/startallpcs

###

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/system/stopallpcs

###

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/system/standbyallpcs

###

POST {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/system/setsetpoint
Content-Type: application/json

{
    "activePowerWatts": 3000000,
    "reactivePowerVars": 1000000
}

###


#------------------------------------------------------------------------------
# Version controller
#------------------------------------------------------------------------------
GET {{paskalON.OperatingModes.Service_HostAddress}}/api/v1/version/
Accept: application/json

###