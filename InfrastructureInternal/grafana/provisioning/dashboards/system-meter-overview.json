            "targets": [
                {
                    "datasource": {
                        "type": "influxdb",
                        "uid": "influxdbdatasource"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "WITH latest_state AS (\n  SELECT \"DeviceId\", last_value(gauge ORDER BY time) AS state\n  FROM powermeter_state\n  WHERE \"MeterType\" = 'System' AND $__timeFilter(time)\n  GROUP BY \"DeviceId\"\n),\nlatest_communication_error AS (\n  SELECT \"DeviceId\", last_value(gauge ORDER BY time) AS communication_error\n  FROM powermeter_communicationerror\n  WHERE \"MeterType\" = 'System' AND $__timeFilter(time)\n  GROUP BY \"DeviceId\"\n),\nsystem_meter AS (\n  SELECT s.\"DeviceId\"\n  FROM latest_state s\n  JOIN latest_communication_error c ON s.\"DeviceId\" = c.\"DeviceId\"\n  WHERE s.state = 3 AND c.communication_error = 0\n  ORDER BY CAST(s.\"DeviceId\" AS BIGINT)\n  LIMIT 1\n)\nSELECT $__dateBin(v.time) AS time, avg(v.gauge) AS \"Active Power\"\nFROM powermeter_activepower v\nJOIN system_meter m ON v.\"DeviceId\" = m.\"DeviceId\"\nWHERE \"MeterType\" = 'System' AND $__timeFilter(v.time)\nGROUP BY 1\nORDER BY 1",
                    "refId": "A"
                },
                {
                    "datasource": {
                        "type": "influxdb",
                        "uid": "influxdbdatasource"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "WITH latest_state AS (\n  SELECT \"DeviceId\", last_value(gauge ORDER BY time) AS state\n  FROM powermeter_state\n  WHERE \"MeterType\" = 'System' AND $__timeFilter(time)\n  GROUP BY \"DeviceId\"\n),\nlatest_communication_error AS (\n  SELECT \"DeviceId\", last_value(gauge ORDER BY time) AS communication_error\n  FROM powermeter_communicationerror\n  WHERE \"MeterType\" = 'System' AND $__timeFilter(time)\n  GROUP BY \"DeviceId\"\n),\nsystem_meter AS (\n  SELECT s.\"DeviceId\"\n  FROM latest_state s\n  JOIN latest_communication_error c ON s.\"DeviceId\" = c.\"DeviceId\"\n  WHERE s.state = 3 AND c.communication_error = 0\n  ORDER BY CAST(s.\"DeviceId\" AS BIGINT)\n  LIMIT 1\n)\nSELECT $__dateBin(v.time) AS time, avg(v.gauge) AS \"Reactive Power\"\nFROM powermeter_reactivepower v\nJOIN system_meter m ON v.\"DeviceId\" = m.\"DeviceId\"\nWHERE \"MeterType\" = 'System' AND $__timeFilter(v.time)\nGROUP BY 1\nORDER BY 1",
                    "refId": "B"
                },
                {
                    "datasource": {
                        "type": "influxdb",
                        "uid": "influxdbdatasource"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "WITH latest_state AS (\n  SELECT \"DeviceId\", last_value(gauge ORDER BY time) AS state\n  FROM powermeter_state\n  WHERE \"MeterType\" = 'System' AND $__timeFilter(time)\n  GROUP BY \"DeviceId\"\n),\nlatest_communication_error AS (\n  SELECT \"DeviceId\", last_value(gauge ORDER BY time) AS communication_error\n  FROM powermeter_communicationerror\n  WHERE \"MeterType\" = 'System' AND $__timeFilter(time)\n  GROUP BY \"DeviceId\"\n),\nsystem_meter AS (\n  SELECT s.\"DeviceId\"\n  FROM latest_state s\n  JOIN latest_communication_error c ON s.\"DeviceId\" = c.\"DeviceId\"\n  WHERE s.state = 3 AND c.communication_error = 0\n  ORDER BY CAST(s.\"DeviceId\" AS BIGINT)\n  LIMIT 1\n)\nSELECT $__dateBin(v.time) AS time, avg(abs(v.gauge)) AS \"Power Factor\"\nFROM powermeter_powerfactor v\nJOIN system_meter m ON v.\"DeviceId\" = m.\"DeviceId\"\nWHERE \"MeterType\" = 'System' AND $__timeFilter(v.time)\nGROUP BY 1\nORDER BY 1",
                    "refId": "C"
                }
