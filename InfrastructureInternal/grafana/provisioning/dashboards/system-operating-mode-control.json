                        "uid": "influxdbdatasource"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT $__dateBin(time) AS time, avg(gauge) AS \"SetpointReactivePower\"\nFROM systemoperatingmodecontrol_setpointreactivepower\nWHERE '${PowerType}' IN ('All', 'Reactive') AND $__timeFilter(time)\nGROUP BY 1\nORDER BY 1",
                    "refId": "E"
