            "targets": [
                {
                    "datasource": {
                        "type": "influxdb",
                        "uid": "influxdbdatasource"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT $__dateBin(time) AS time, avg(gauge) AS \"SetpointActivePower\"\nFROM systemoperatingmodecontrol_setpointactivepower\nWHERE '${PowerType}' IN ('All', 'Active') AND $__timeFilter(time)\nGROUP BY 1\nORDER BY 1",
                    "refId": "A"
                },
                {
                    "datasource": {
                        "type": "influxdb",
                        "uid": "influxdbdatasource"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT $__dateBin(time) AS time, avg(gauge) AS \"SetpointActivePowerActual\"\nFROM systemoperatingmodecontrol_setpointactivepoweractual\nWHERE '${PowerType}' IN ('All', 'Active') AND $__timeFilter(time)\nGROUP BY 1\nORDER BY 1",
                    "refId": "B"
                },
                {
                    "datasource": {
                        "type": "influxdb",
                        "uid": "influxdbdatasource"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT $__dateBin(time) AS time, avg(gauge) AS \"ActivePowerObjective\"\nFROM systemoperatingmodecontrol_activepowerobjective\nWHERE '${PowerType}' IN ('All', 'Active') AND $__timeFilter(time)\nGROUP BY 1\nORDER BY 1",
                    "refId": "C"
                },
                {
                    "datasource": {
                        "type": "influxdb",
                        "uid": "influxdbdatasource"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT $__dateBin(time) AS time, avg(gauge) AS \"AdditiveActivePowerDelta\"\nFROM systemoperatingmodecontrol_additiveactivepowerdelta\nWHERE '${PowerType}' IN ('All', 'Active') AND $__timeFilter(time)\nGROUP BY 1\nORDER BY 1",
                    "refId": "D"
                },
                {
                    "datasource": {
