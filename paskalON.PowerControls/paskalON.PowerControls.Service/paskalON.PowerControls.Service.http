#------------------------------------------------------------------------------
# Variables
#------------------------------------------------------------------------------
@paskalON.PowerControls.Service_HostAddress = http://localhost:45010

#------------------------------------------------------------------------------
# System controller
#------------------------------------------------------------------------------
POST {{paskalON.PowerControls.Service_HostAddress}}/api/v1/system/setpowersetpoints
Content-Type: application/json

{
    "ActivePowerWatt": 100000,
    "ReactivePowerVar": 20000
}

###

POST {{paskalON.PowerControls.Service_HostAddress}}/api/v1/system/startallpcs

###

POST {{paskalON.PowerControls.Service_HostAddress}}/api/v1/system/stopallpcs

###

POST {{paskalON.PowerControls.Service_HostAddress}}/api/v1/system/standbyallpcs

###

#------------------------------------------------------------------------------
# Version controller
#------------------------------------------------------------------------------
GET {{paskalON.PowerControls.Service_HostAddress}}/api/v1/version/
Accept: application/json

###
