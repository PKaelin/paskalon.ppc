#------------------------------------------------------------------------------
# Variables
#------------------------------------------------------------------------------
@paskalON.Luna.Service_HostAddress = http://localhost:45550


#------------------------------------------------------------------------------
# Device Controller
# Commands are forwarded to the device service
#------------------------------------------------------------------------------
@device.unitName = BMS-Unit 1
@device.pcsDeviceId = 1
@device.batteryBankDeviceId = 11

GET {{paskalON.Luna.Service_HostAddress}}/api/v1/device/getder


###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/device/putintomaintenance
Content-Type: application/json

{
    "unitName": "{{device.unitName}}"
}

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/device/startallpcs

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/device/startpcs
Content-Type: application/json

{
    "deviceId": {{device.pcsDeviceId}}
}

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/device/stopallpcs

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/device/stoppcs
Content-Type: application/json

{
    "deviceId": {{device.pcsDeviceId}}
}

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/device/standbyallpcs

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/device/standbypcs
Content-Type: application/json

{
    "deviceId": {{device.pcsDeviceId}}
}

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/device/connectbatterybank
Content-Type: application/json

{
    "deviceId": {{device.batteryBankDeviceId}}
}

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/device/disconnectbatterybank
Content-Type: application/json

{
    "deviceId": {{device.batteryBankDeviceId}}
}

###


#------------------------------------------------------------------------------
# Operating mode controller (forwarded to the operating mode service)
# Modes: ActivePowerFixedMode, ReactivePowerFixedMode, ActivePowerMode,
#        ReactivePowerMode
#------------------------------------------------------------------------------
@operatingMode.operatingModeName = ActivePowerFixedMode
@operatingMode.replacingOperatingModeName = ActivePowerMode

GET {{paskalON.Luna.Service_HostAddress}}/api/v1/operatingmode/getavailableoperatingmodes
Accept: application/json

###

GET {{paskalON.Luna.Service_HostAddress}}/api/v1/operatingmode/getactiveoperatingmodes
Accept: application/json

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/operatingmode/addoperatingmode
Content-Type: application/json

{
    "operatingModeName": "{{operatingMode.operatingModeName}}",
    "priority": 1
}

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/operatingmode/moveoperatingmode
Content-Type: application/json

{
    "operatingModeName": "{{operatingMode.operatingModeName}}",
    "priority": 2
}

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/operatingmode/replaceoperatingmode
Content-Type: application/json

{
    "predecessorName": "{{operatingMode.operatingModeName}}",
    "operatingModeName": "{{operatingMode.replacingOperatingModeName}}"
}

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/operatingmode/removeoperatingmode
Content-Type: application/json

{
    "operatingModeName": "{{operatingMode.operatingModeName}}"
}

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/operatingmode/setsetpoint
Content-Type: application/json

{
    "activePowerWatts": 3630000,
    "reactivePowerVars": 1830000
}

###


#------------------------------------------------------------------------------
# Operating mode controller - overrides (forwarded to the operating mode service)
# Modes: ShutdownMode, MaintenanceMode-BMS-Unit1
#------------------------------------------------------------------------------
@operatingMode.overrideOperatingModeName = ShutdownMode

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/operatingmode/activateoverrideoperatingmode
Content-Type: application/json

{
    "operatingModeName": "{{operatingMode.overrideOperatingModeName}}"
}

###

POST {{paskalON.Luna.Service_HostAddress}}/api/v1/operatingmode/deactivateoverrideoperatingmode
Content-Type: application/json

{
    "operatingModeName": "{{operatingMode.overrideOperatingModeName}}"
}

###
