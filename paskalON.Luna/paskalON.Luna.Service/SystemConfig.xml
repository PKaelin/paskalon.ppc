    <SubscriberTopicOperatingModeHeartbeat>ppc:om:heartbeat</SubscriberTopicOperatingModeHeartbeat>
    <!-- Devices subscriber topics -->
    <SubscriberTopicPcsCore>ppc:device:pcs:core</SubscriberTopicPcsCore>
    <SubscriberTopicPcsDetail>ppc:device:pcs:detail</SubscriberTopicPcsDetail>
    <SubscriberTopicBatteryBankCore>ppc:device:bb:core</SubscriberTopicBatteryBankCore>
    <SubscriberTopicBatteryBankDetail>ppc:device:bb:detail</SubscriberTopicBatteryBankDetail>
    <SubscriberTopicSolarPanelCore>ppc:device:pv:core</SubscriberTopicSolarPanelCore>
    <SubscriberTopicSolarPanelDetail>ppc:device:pv:detail</SubscriberTopicSolarPanelDetail>
    <SubscriberTopicExternalPowerMeterCore>ppc:device:pm:external:core</SubscriberTopicExternalPowerMeterCore>
